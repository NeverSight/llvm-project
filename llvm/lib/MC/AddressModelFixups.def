#ifdef REWRITE_FIXUP_STRING
REWRITE_FIXUP_STRING(GOTSymbolName, "_GLOBAL_OFFSET_TABLE_")
REWRITE_FIXUP_STRING(GOTSpecifierName, "GOT")
REWRITE_FIXUP_STRING(GOTOFFSpecifierName, "GOTOFF")
REWRITE_FIXUP_STRING(I386GOTPCFixupName, "reloc_global_offset_table")
REWRITE_FIXUP_STRING(UnresolvedI386GOTAnchor, "cannot resolve i386 GOT anchor")
#undef REWRITE_FIXUP_STRING
#endif

#ifdef REWRITE_FIXUP_INTEGER
REWRITE_FIXUP_INTEGER(MachOGOTPCRelDataBias, 4)
#undef REWRITE_FIXUP_INTEGER
#endif
