AARCH64_STACK_PROBE_TEXT(Helper, "__chkstk_darwin")
AARCH64_STACK_PROBE_TEXT(MethodAttr, "probe-stack")
AARCH64_STACK_PROBE_TEXT(SizeAttr, "stack-probe-size")
AARCH64_STACK_PROBE_TEXT(Inline, "inline-asm")
AARCH64_STACK_PROBE_TEXT(Unsupported, "Unsupported stack probing method")
AARCH64_STACK_PROBE_TEXT(AuthCalls, "ptrauth-calls")
AARCH64_STACK_PROBE_TEXT(LOHLabel, "loh")
AARCH64_STACK_PROBE_UINT(DefaultProbeSize, 4096)
AARCH64_STACK_PROBE_UINT(PlainCallBytes, 12)
AARCH64_STACK_PROBE_UINT(AuthenticatedCallBytes, 16)
#undef AARCH64_STACK_PROBE_UINT
#undef AARCH64_STACK_PROBE_TEXT
