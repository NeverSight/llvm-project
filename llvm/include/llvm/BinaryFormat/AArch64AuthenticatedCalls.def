AARCH64_AUTH_CALL_TEXT(InvalidKey, "Invalid authenticated call key")
AARCH64_AUTH_CALL_TEXT(AddressDiverseSuffix, "$addr")
AARCH64_AUTH_CALL_UINT(DataKeyExtraBytes, 8)
#undef AARCH64_AUTH_CALL_UINT
#undef AARCH64_AUTH_CALL_TEXT
